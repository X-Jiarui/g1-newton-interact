+def _zspace_group_tensor(obs: TensorDict, spec: str) -> torch.Tensor:
+  """'name' or 'name[a:b]' -> (B, d) slice of that observation group."""
+  name, sl = spec, slice(None)
+  if "[" in spec:
+    name, rng = spec[:-1].split("[")
+    a, b = rng.split(":")
+    sl = slice(int(a) if a else None, int(b) if b else None)
+  t = cast(torch.Tensor, obs[name])
+  return t.reshape(t.shape[0], -1)[:, sl]
