+  def _zspace_anchor(self, obs: TensorDict) -> tuple[torch.Tensor, torch.Tensor]:
+    """Normalised s and the latent the residual is added to (encoder mean or prior mean)."""
+    zs = cast(nn.Module, self.zspace)
+    s_raw = torch.cat([_zspace_group_tensor(obs, g) for g in self.zspace_self_groups], dim=-1).float()
+    g_raw = torch.cat([_zspace_group_tensor(obs, g) for g in self.zspace_task_groups], dim=-1).float()
+    dev = s_raw.device
+    if next(zs.parameters()).device != dev:
+      zs.to(dev)
+    if self.zspace_ref_default is not None:
+      # proprio_history's joint columns are `q - ref["default_body"]`, and that default is the MEAN
+      # POSE OF THE CLIP SET the env was built with -- a dataset constant. The student learned the
+      # 1324-clip mix's constant; this env's 8-clip constant differs by up to ~0.5 rad on the arm
+      # joints, so every joint column arrives shifted. Convert to the student's convention:
+      #   q - d_train = (q - d_here) + (d_here - d_train).
+      d_train_b, d_train_h = self.zspace_ref_default
+      ref_here = mdp.apple_mdp._ref(str(dev))
+      db = (ref_here["default_body"].to(dev) - d_train_b.to(dev)).float()
+      dh = (ref_here["default_hand"].to(dev) - d_train_h.to(dev)).float()
+      s_raw = s_raw.clone()
+      for h in range(4):
+        o = h * 144
+        s_raw[:, o:o + 29] += db
+        s_raw[:, o + 58:o + 98] += dh
+    with torch.no_grad():
+      s_n, g_n = zs.normalize(s_raw, g_raw)
+      if self.zspace_mask_hand_input:
+        # A body-only student saw the hand parked at its default pose for every sample, so its
+        # input normaliser has ~zero variance on the 40 hand-joint columns of each history slot;
+        # a hand held by a different PD (kp 10 here vs 300 there) lands 3-5 sigma out and clamps.
+        # Feed the training-time value (normalised 0) on those columns: the body tracker never
+        # used the hand state, and this is the only place the two envs' hands differ.
+        for h in range(4):
+          o = h * 144
+          s_n[:, o + 58:o + 138] = 0.0
+      if os.environ.get("ZSPACE_DEBUG", "").strip() == "1":
+        self._zspace_dbg_n = getattr(self, "_zspace_dbg_n", 0) + 1
+        if self._zspace_dbg_n % 50 == 1:
