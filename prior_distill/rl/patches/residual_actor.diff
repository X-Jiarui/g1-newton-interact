+          #                   + root_z 1 + last_final_action 69 (body 29, hand 40)
+          blocks = []
+          for h in range(4):
+            o = h * 144
+            blocks += [(f"h{h}_body_jp", o, o + 29), (f"h{h}_body_jv", o + 29, o + 58),
+                       (f"h{h}_hand_jp", o + 58, o + 98), (f"h{h}_hand_jv", o + 98, o + 138),
+                       (f"h{h}_rootv", o + 138, o + 141), (f"h{h}_grav", o + 141, o + 144)]
+          blocks += [("root_z", 576, 577), ("last_a_body", 577, 606), ("last_a_hand", 606, 646)]
+          sat = (s_n.abs() >= 4.99).float()
+          msg = " ".join(f"{n}:sat={sat[:, a:b].mean():.2f},|x|={s_n[:, a:b].abs().mean():.2f}"
+                         for n, a, b in blocks if b <= s_n.shape[1])
+          print(f"[zspace-dbg] s_n dims={s_n.shape[1]} {msg} || g_n sat={(g_n.abs() >= 4.99).float().mean():.2f} |g|={g_n.abs().mean():.2f}", flush=True)
+      if _ZSPACE_ANCHOR == "prior":
